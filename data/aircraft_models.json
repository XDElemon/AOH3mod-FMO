    "key": "country*4 + type   (CN=0 EU=1 RU=2 US=3 | FIGHTER=0 INTERCEPTOR=1 ATTACKER=2 BOMBER=3)",
    "imageId": "70 + (gen-3)*16 + key",
    "packed": "(key<<16) | (techId<<8) | imageId",
    "genFromImage": "((imageId-70)>>4)+3"
  },
